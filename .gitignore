# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — игнорим всё КРОМЕ .env.example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Backups создаваемые setup.mjs (brief.config.ts.NNNNN.bak)
*.bak

# OAuth / credential файлы (никогда не коммитить!)
**/token.json
**/token_*.json
**/credentials.json
**/*-credentials.json
**/*.pem
**/*.key

# Legacy mapping scripts (Python) — содержат OAuth токены и внутренние данные.
# Setup wizard (scripts/setup.mjs) и плюрио тест-скрипт остаются.
scripts/*.py
scripts/*.json
scripts/*.csv
scripts/run_*.sh
scripts/run.sh
scripts/README.md
scripts/requirements.txt

# Internal docs / presentations / artifacts — не для публичного репо
plurio_test_out/
plurio_workflow.txt
plurio_workflow.docx
presentation*.html
presentation*.md
creative-system-skill.md
competitor-analysis-prompt.md
creative-system-excalidraw.excalidraw
supabase/.temp/
supabase/.branches/
