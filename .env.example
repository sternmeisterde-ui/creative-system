# ───────────────────────────────────────────────────────────────────────────
# Creative System — пример переменных окружения.
# Скопируй в `.env.local` (для локальной разработки) или добавь в Vercel envs.
#
# Обязательные:  Supabase + Anthropic + Meta
# Опциональные:  Plurio/Elly, Telegram, Higgsfield, ElevenLabs, Creatomate, Gemini
# ───────────────────────────────────────────────────────────────────────────

# ─── Supabase (ОБЯЗАТЕЛЬНО) ────────────────────────────────────────────────
# Создай проект на https://supabase.com → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# ─── Anthropic / Claude (ОБЯЗАТЕЛЬНО) ──────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Meta Marketing API (ОБЯЗАТЕЛЬНО) ──────────────────────────────────────
# Получить System User token в https://business.facebook.com/settings → Users → System Users
# Token должен иметь scopes: ads_read, ads_management, read_insights, business_management
# Recommended: Expiration = Never (System User token).
META_ACCESS_TOKEN=EAA...your-system-user-token...

# Ad accounts — по одному env-у на каждый flow из brief.config.ts.
# Имена env-переменных задаются полем `meta_account_env` каждого flow.
# Пример для двух flows (com, gov) — поменяй на свои:
META_AD_ACCOUNT_ID_COM=act_1111111111111111
META_AD_ACCOUNT_ID_GOV=act_2222222222222222

# ─── Plurio / Elly (ОПЦИОНАЛЬНО — для лидов/CPL аналитики) ─────────────────
# Если у тебя нет Plurio/Elly — оставь пустым, /api/pbi/elly-sync вернёт 503.
# CPL/CPQL/fake_winner detection без этих данных НЕ работают —
# только spend/impressions/clicks из Meta. Настоятельно рекомендуется заполнить.
PLURIO_API_KEY=
PLURIO_PROJECT_ID=

# ─── Telegram alerts (ОПЦИОНАЛЬНО) ─────────────────────────────────────────
# Без них алерты по лузерам/fake_winners просто не отправляются. Логика работает.
# Получить токен бота: @BotFather → /newbot. Chat ID: написать боту, потом GET /getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Higgsfield (ОПЦИОНАЛЬНО — генерация креативов) ────────────────────────
# Без них модуль /creatives генерации видео/статики не работает.
# Анализ + брифы работают без них.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_API_URL=https://platform.higgsfield.ai

# ─── ElevenLabs (ОПЦИОНАЛЬНО — voiceover для видео) ────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Sync.so (ОПЦИОНАЛЬНО — lipsync для видео) ─────────────────────────────
SYNCSO_API_KEY=

# ─── Creatomate (ОПЦИОНАЛЬНО — склейка сцен в финальное видео) ─────────────
CREATOMATE_API_KEY=

# ─── Gemini (ОПЦИОНАЛЬНО — vision-анализ креативов конкурентов) ────────────
# Используется в /analyze. Без неё страница не работает.
GEMINI_API_KEY=
